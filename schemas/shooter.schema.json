{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://game-protocol/schemas/shooter.schema.json",
  "title": "GAME.md front-matter — perfil shooter",
  "type": "object",
  "required": [
    "version",
    "name",
    "profile"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "profile": {
      "const": "shooter"
    },
    "platform": {
      "type": "object"
    },
    "palettesCount": {
      "type": "integer",
      "minimum": 0
    },
    "ships": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "hp": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "speed",
          "hp"
        ]
      }
    },
    "weapons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "damage": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bulletSpeed": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "damage",
          "rate",
          "bulletSpeed"
        ]
      }
    },
    "enemies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "points": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "hp",
          "speed"
        ]
      }
    },
    "waves": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "spawns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "gap": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "powerups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "arena": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "player": {
      "type": "object"
    },
    "balance": {
      "type": "object",
      "properties": {
        "powerupChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lives": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "text": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "x-sections": [
    "Overview",
    "Ships",
    "Weapons",
    "Enemies",
    "Waves",
    "Arena",
    "Text",
    "Do's and Don'ts"
  ],
  "x-references": [
    {
      "rule": "ship-weapon-ref",
      "from": "ships.*.weapon",
      "to": "weapons"
    },
    {
      "rule": "enemy-weapon-ref",
      "from": "enemies.*.weapon",
      "to": "weapons"
    },
    {
      "rule": "wave-enemy-ref",
      "from": "waves.*.spawns[].enemy",
      "to": "enemies"
    },
    {
      "rule": "player-ship-ref",
      "from": "player.ship",
      "to": "ships"
    }
  ],
  "x-outputKeys": [
    "SHIPS",
    "WEAPONS",
    "ENEMIES",
    "WAVES",
    "POWERUPS",
    "ARENA",
    "PLAYER",
    "BALANCE",
    "TEXT"
  ],
  "x-note": "Las referencias cruzadas (x-references) dependen de datos y se validan con game-lint.js, no con este schema."
}
